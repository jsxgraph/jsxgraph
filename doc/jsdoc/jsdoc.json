{
  "source": {
    "include": []
  },
  "plugins": [
    "./doc/jsdoc/plugins/jsdoc-newsignature-plugin/index.js",
    "./doc/jsdoc/plugins/jsxgraph-pseudo-class-plugin/index.js",
    "plugins/markdown",
    "plugins/summarize"
  ],
  "opts": {
    "template": "./doc/jsdoc/templates/docdash-jsxgraph",
    "destination": "./output_docs",
    "recurse": true,
    "verbose": true,
    "tutorials": "tutorials/",
    "encoding": "utf8"
  },
  "sourceType": "module",
  "tags": {
    "allowUnknownTags": true
  },
  "templates": {
    "default": {
      "useLongnameInNav": true
    }
  },
  "docdash": {
    "jsxgraphStyle": true,
    "commonNav": true,
    "search": true,
    "collapse": true,
    "private": true,
    "menu": {
        "JSXGraph": {
            "href":"https://jsxgraph.org/",
            "target":"_blank",
            "class":"menu-item",
            "id":"website_link"
        },
        "Forum": {
            "href":"https://forum.jsxgraph.org/",
            "target":"_blank",
            "class":"menu-item",
            "id":"forum_link"
        }
    }    
  }
}

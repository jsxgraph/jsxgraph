{
  "source": {
    "include": []
  },
  "meta": {                       
    "title": "JSXGraph API",
    "description": "JSXGraph API documentation",
    "keyword": "JSXGraph"
  },
  "plugins": [
    "./doc/jsdoc/plugins/jsdoc-newsignature-plugin/index.js",
    "./doc/jsdoc/plugins/jsxgraph-pseudo-class-plugin/index.js",
    "plugins/markdown",
    "plugins/summarize"
  ],
  "opts": {
    "template": "./doc/jsdoc/templates/docdash-jsxgraph",
    "destination": "./tmp/docs",
    // "recurse": true,
    "verbose": true,
    // "tutorials": "src/tutorials/",
    "encoding": "utf8"
  },
  "sourceType": "module",
  "tags": {
    "allowUnknownTags": ["visprop"]
  },
  "templates": {
    "default": {
      "includeDate": false,
      "useLongnameInNav": true
    }
  },
  "docdash": {
    "jsxgraphStyle": true,
    "commonNav": false,
    "search": true,
    "collapse": false,
    "private": true,
    "menu": {
        "JSXGraph": {
            "href":"https://jsxgraph.org/",
            "target":"_blank",
            "class":"menu-item",
            "id":"website_link"
        },
        "Forum": {
            "href":"https://forum.jsxgraph.org/",
            "target":"_blank",
            "class":"menu-item",
            "id":"forum_link"
        }
    }    
  }
}
